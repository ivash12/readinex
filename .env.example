# Supabase: URL + anon key are PUBLIC (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key: SERVER-ONLY, use only in src/server and scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (LLM, speech-to-text, text-to-speech): SERVER-ONLY.
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Upstash Redis (rate limiting / cache): SERVER-ONLY.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest background jobs: SERVER-ONLY.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Payments provider: SERVER-ONLY.
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Sentry: DSN is PUBLIC (sent from the browser).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token (source map upload at build time): SERVER-ONLY.
SENTRY_AUTH_TOKEN=
